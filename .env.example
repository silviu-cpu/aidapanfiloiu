# EmailJS: formularul „Vrei să te sun eu?” trimite cererea direct din browser.
# Copiază fișierul ca .env.local (pentru dezvoltare) și pune aceleași variabile în producție.
# Valorile se găsesc în contul EmailJS: Email Services, Email Templates și Account > General.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxx
